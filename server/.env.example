# Copy this file to .env and fill in real values.
# Never commit .env to Git.

# IBM Cloudant service URL — found in your IBM Cloud Cloudant service credentials.
# Example: https://your-instance.cloudantnosqldb.appdomain.cloud
CLOUDANT_URL=https://your-instance.cloudantnosqldb.appdomain.cloud

# IBM Cloud IAM API key for the Cloudant service.
CLOUDANT_APIKEY=your-iam-api-key-here

# Name of the Cloudant database that holds the supplier documents.
CLOUDANT_DB=suppliers

# TCP port the Express server listens on (optional, defaults to 3000).
PORT=3000

# IBM watsonx.ai Runtime settings for POST /api/extract.
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-project-id
WATSONX_API_KEY=your-watsonx-iam-key
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct
